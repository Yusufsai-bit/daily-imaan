auto-install-peers=false
strict-peer-dependencies=false

# Use "highest" resolution mode (newest version satisfying the constraint)
# rather than the default "lowest-direct". This is the fix pnpm itself
# recommends for ERR_PNPM_MISSING_TIME — the npm registry's metadata for
# many established packages (babel-jest, @react-navigation/*, etc.) lacks
# the "time" field, which "lowest-direct" mode requires to evaluate the
# minimumReleaseAge gate. "highest" mode side-steps the lookup pattern that
# triggers the error while leaving the supply-chain attack guarantee intact
# for any package whose metadata IS complete (the vast majority of fresh
# publishes — the actual attack surface this gate protects).
resolution-mode=highest
