{
  "expo": {
    "name": "Daily Imaan",
    "slug": "daily-imaan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily-imaan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6B4A",
      "dark": {
        "image": "./assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F2E22"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dailyimaan.app",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Daily Imaan needs your location to calculate accurate prayer times.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dailyimaan.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A6B4A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1A6B4A",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Daily Imaan needs your location to calculate accurate prayer times."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "_comment": "REQUIRED FOR APP STORE BUILDS — replace with your 10-character Apple Developer Team ID before running `eas build --profile production --platform ios`. Find it at https://developer.apple.com/account → Membership.",
          "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
        }
      ],
      "./plugins/withAndroidWidget.js",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
